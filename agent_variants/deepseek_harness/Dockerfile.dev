# syntax=docker/dockerfile:1.7

ARG PYTHON_DEPS_IMAGE=trace-redteam-agent-qwen:g6-local
FROM ${PYTHON_DEPS_IMAGE} AS python-deps
FROM node:24.14.0-bookworm-slim AS node-runtime

WORKDIR /opt/harness-deps
COPY agent_variants/deepseek_harness/package.json agent_variants/deepseek_harness/package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM python:3.11.9-slim-bookworm@sha256:8fb099199b9f2d70342674bd9dbccd3ed03a258f26bbd1d556822c6dfc60c317

LABEL org.trace-g.runtime="deepseek-harness-h4-v1" \
      org.trace-g.agent-runtime="deepseek_harness" \
      org.trace-g.composition-sha256="cc2de463739e5e987e188a199ba35653a21844c3015135a6033a293c144f92dd" \
      org.trace-g.provider="office-v2-h4-deterministic" \
      org.trace-g.contains-model="false"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/runtime:/opt/runtime/src \
    HOME=/tmp/trace-g-home \
    TRACE_G_FORMAL_AGENT=1 \
    TRACE_G_AGENT_RUNTIME=deepseek_harness \
    TRACE_G_HARNESS_VARIANT_ROOT=/opt/runtime/agent_variants/deepseek_harness \
    TRACE_G_PYTHON_RUNTIME_ROOT=/opt/runtime \
    LANGSMITH_TRACING=false \
    LANGCHAIN_TRACING_V2=false

WORKDIR /opt/runtime

COPY --from=python-deps /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node

RUN groupadd --gid 10001 sandbox \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin sandbox \
    && mkdir -p /tmp/trace-g-home \
    && chown 10001:10001 /tmp/trace-g-home

COPY src/sandbox ./src/sandbox
COPY agent_image/app ./app
COPY agent_variants/deepseek_harness/package.json agent_variants/deepseek_harness/package-lock.json ./agent_variants/deepseek_harness/
COPY --from=node-runtime /opt/harness-deps/node_modules ./agent_variants/deepseek_harness/node_modules
COPY agent_variants/deepseek_harness/office_v2.cordis.yml ./agent_variants/deepseek_harness/office_v2.cordis.yml
COPY agent_variants/deepseek_harness/runtime ./agent_variants/deepseek_harness/runtime
COPY agent_variants/deepseek_harness/locks ./agent_variants/deepseek_harness/locks

USER 10001:10001
EXPOSE 8080

HEALTHCHECK --interval=2s --timeout=1s --start-period=5s --retries=15 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=1)"

ENTRYPOINT ["python", "-m", "uvicorn", "app.server:app", "--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
