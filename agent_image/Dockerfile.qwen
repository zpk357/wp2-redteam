# syntax=docker/dockerfile:1.7

ARG OLLAMA_IMAGE=ollama/ollama:0.32.1
FROM ${OLLAMA_IMAGE} AS ollama-runtime
FROM wheelhouse AS python-wheelhouse
FROM ollama-models AS model-assets

FROM python:3.11.9-slim-bookworm@sha256:8fb099199b9f2d70342674bd9dbccd3ed03a258f26bbd1d556822c6dfc60c317

ARG MODEL_NAME=qwen3.5:27b-q4_K_M
ARG MODEL_MANIFEST_PATH=registry.ollama.ai/library/qwen3.5/27b-q4_K_M

LABEL org.trace-g.runtime="self-contained-agent-qwen" \
      org.trace-g.role="agent" \
      org.trace-g.agent-framework="langgraph" \
      org.trace-g.model.name="${MODEL_NAME}" \
      org.trace-g.ollama.version="0.32.1" \
      org.trace-g.langgraph.version="1.2.10"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/opt/runtime \
    HOME=/tmp/trace-g-home \
    OLLAMA_HOST=127.0.0.1:11434 \
    OLLAMA_MODELS=/opt/ollama-models \
    OLLAMA_NOHISTORY=1 \
    TRACE_G_RUNTIME_MODE=live \
    TRACE_G_OLLAMA_ENDPOINT=http://127.0.0.1:11434 \
    TRACE_G_MODEL_NAME=${MODEL_NAME} \
    LANGSMITH_TRACING=false \
    LANGCHAIN_TRACING_V2=false

WORKDIR /opt/runtime

COPY --from=ollama-runtime /usr/bin/ollama /usr/bin/ollama
COPY --from=ollama-runtime /usr/lib/ollama /usr/lib/ollama
COPY --from=python-wheelhouse / /tmp/wheelhouse/
COPY agent_image/requirements.agent-qwen.lock ./requirements.agent-qwen.lock
RUN python -m pip install --no-index --find-links=/tmp/wheelhouse \
        --only-binary=:all: --require-hashes \
        --requirement requirements.agent-qwen.lock \
    && python -m pip check \
    && python -c "from langgraph.graph import StateGraph; from langchain_ollama import ChatOllama; print('agent-qwen-python-stack-ok')" \
    && rm -rf /tmp/wheelhouse \
    && groupadd --gid 10001 sandbox \
    && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin sandbox \
    && mkdir -p /tmp/trace-g-home \
    && chown 10001:10001 /tmp/trace-g-home

COPY --from=model-assets / /opt/ollama-models/
COPY src/sandbox ./sandbox
COPY agent_image/app ./app

RUN test -f "/opt/ollama-models/manifests/${MODEL_MANIFEST_PATH}"

USER 10001:10001
EXPOSE 8080

HEALTHCHECK --interval=5s --timeout=2s --start-period=180s --retries=6 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=1)"

ENTRYPOINT ["python", "-m", "app.agent_qwen_bootstrap"]
